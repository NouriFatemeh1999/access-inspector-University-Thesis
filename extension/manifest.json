{
  "manifest_version": 3,
  "name": "Access Inspector",
  "version": "1.0",
  "description": "A gamified accessibility testing tool built on top of Sa11y",
  "icons": {
    "16": "icons/icon96.png",
    "48": "icons/icon96.png",
    "128": "icons/icon96.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon96.png",
      "48": "icons/icon96.png",
      "128": "icons/icon96.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ngrok_rules",
        "enabled": true,
        "path": "ngrok_rules.json"
      }
    ]
  },
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3000/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sa11y.umd.js",
        "en.umd.js",
        "sa11y.css",
        "game-override.css",
        "game-ui.js",
        "game.js",
        "overlay.css",
        "icons/avatars/*",
        "icons/others/welcome.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}